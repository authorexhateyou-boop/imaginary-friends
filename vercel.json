{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "regions": ["sin1"],
  "rewrites": [{ "source": "/studio", "destination": "/studio.html" }, { "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "{legal/**,node_modules/ffmpeg-static/ffmpeg,node_modules/@supabase/supabase-js/dist/umd/supabase.js}"
    }
  }
}
