# ---- Kravitas configuration ----
# Copy to .env for local runs. On Railway, add these under Variables instead.

# fal.ai key that pays for all generations (https://fal.ai/dashboard/keys). Empty = demo mode.
FAL_KEY=

# Supabase (Project Settings → API). Leave empty to run in single-user local mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media

# Stripe (Developers → API keys / Webhooks). Leave empty to hide top-ups.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=myr

# Your public site address, used for Stripe return links, e.g. https://imaginaryfriends.up.railway.app
PUBLIC_URL=

# Credits given to every new guest (1 credit ≈ US$0.01 of AI cost). Keep it small to limit abuse.
FREE_CREDITS=30
# Credit packs for sale (price in whole RM). Optional; defaults shown.
# PACKS=[{"id":"starter","name":"Starter","credits":400,"price":25},{"id":"creator","name":"Creator","credits":1000,"price":59,"tag":"Popular"},{"id":"pro","name":"Pro","credits":2800,"price":149,"tag":"Best value"}]

# Script-writing model on OpenRouter via fal.
LLM_MODEL=google/gemini-2.5-flash
# Max generations one user can run at the same time.
MAX_RUNNING_JOBS=3
# Secret for the admin API (grant credits, list users). Make it long and random.
ADMIN_TOKEN=

# Shown on /terms and /privacy.
COMPANY_NAME=Treelion Enterprise
SUPPORT_EMAIL=
